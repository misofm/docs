{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miso-docs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "routes": [
    { "pattern": "docs.miso.fm", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
